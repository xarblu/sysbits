#!/usr/bin/bash

# pycargoebuild but applied to all subdirectories
# containing a Cargo.toml file

set -o pipefail
shopt -s dotglob

function log() {
    printf "%s\n" "${*}" 1>&2
}

function die() {
    log "${@}"
    exit 1
}

function merge-ebuild-vars() {
    local dir="${1}"
    local var="${2}"

    local -a merged
    local var_decl=""
    local var_open_delim='"'
    local var_close_delim='"'

    # parse var metadata
    IFS=';' read -r var_decl var_open_delim var_close_delim < <(perl -0777 -n -e 'while ($_ =~ /(declare -.+? )?'"${var}"'\+?=(["\(]).*?(["\)])/gms) { print "$1;$2;$3\n"; last }' "${dir}"/*.ebuild)

    # parse var values
    read -r -d '' -a merged < <(perl -0777 -n -e 'while ($_ =~ /'"${var}"'\+?='"${var_open_delim/\(/\\\(}"'(.*?)'"${var_close_delim/\)/\\\)}"'/gms) { print "$1\n" }' "${dir}"/*.ebuild)

    # dedupe and strip metachars
    # (TODO: currently converts "|| (...)" licenses to "and")
    read -r -d '' -a merged < <(printf "%s\n" "${merged[@]}" | sort -u | grep -F -v $'||\n(\n)')

    printf "%s%s=%s\n" "${var_decl}" "${var}" "${var_open_delim}"
    printf "\t%s\n" "${merged[@]}"
    printf "%s\n" "${var_close_delim}"
}

function main() {
    local cargo_toml
    local dir
    local tempdir

    tempdir="$(mktemp -d)" || die "mktemp failed"

    while IFS='' read -r -d '' cargo_toml; do
        log "Processing ${cargo_toml@Q}..."

        if grep -qF '[workspace]' "${cargo_toml}"; then
            log "${cargo_toml@Q} looks like a workspace, skipping..."
            continue
        fi        

        dir="${cargo_toml%/Cargo.toml}"
        dir="${dir#./}"
        [[ -n "${dir}" ]] || dir="."

        pycargoebuild \
            --force \
            --fill-crates \
            --output "${tempdir}/${dir//\//-}.ebuild" \
            "${dir}" \
            1>&2 \
            || die "pycargoebuild failed"

    done < <(find . -type f -name Cargo.toml -print0)

    merge-ebuild-vars "${tempdir}" CRATES
    printf "\n"
    merge-ebuild-vars "${tempdir}" GIT_CRATES
    printf "\n"
    printf "# Dependent crate licenses\n"
    merge-ebuild-vars "${tempdir}" LICENSE
}

main "${@}"
