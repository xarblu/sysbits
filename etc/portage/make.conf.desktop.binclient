### Main portage configuration file ###

# === bashrc flag manager ===
# base *FLAGS to expand with bashrc flag manager
TARGET_CPU="x86-64-v3"
COMMON_FLAGS="-march=${TARGET_CPU} -O3 -pipe"
RUSTFLAGS="-C target-cpu=${TARGET_CPU} -C opt-level=3 -C debuginfo=0 -C codegen-units=1"
LDFLAGS="-Wl,-O3,--as-needed"

# toggles for various things
# need to be true/false
ENABLE_LTO="true"
ENABLE_POLLY="false"
ENABLE_MOLD="false"
ENABLE_ICF="true"
ENABLE_SCCACHE="false"

# Compiler caches
#FEATURES="${FEATURES} ccache"
#CCACHE_DIR="/var/cache/ccache"

# defaults
source /usr/share/sysbits/portage/make.conf.d/defaults.conf

# binpkg client options
EMERGE_DEFAULT_OPTS="${EMERGE_DEFAULT_OPTS} --getbinpkg=y --binpkg-changed-deps=y --binpkg-respect-use=y --rebuilt-binaries=y"
EMERGE_DEFAULT_OPTS="${EMERGE_DEFAULT_OPTS} --usepkg-exclude app-misc/sysbits"

# Jobserver
source /usr/share/sysbits/portage/make.conf.d/jobserver.conf

# Scheduling priority
source /usr/share/sysbits/portage/make.conf.d/scheduling-priority.conf

# Portage directories
source /usr/share/sysbits/portage/make.conf.d/directories.conf

# Gentoo mirrors and fetchcommand
source /usr/share/sysbits/portage/make.conf.d/fetchcommand.conf
source /usr/share/sysbits/portage/gentoo_mirrors.list
