# For the rare cases where clang++ fails
# but LLVM libc++ works.
# Should be preferred over plain gcc (with libstdc++)
# on LLVM systems.

# shellcheck disable=SC2034

CC="gcc"
CXX="g++"
OBJCC="gcc"
OBJCXX="g++"
CPP="cpp"
LD="ld.bfd"
AS="as"
AR="ar"
NM="nm"
STRIP="strip"
RANLIB="ranlib"
OBJCOPY="objcopy"
OBJDUMP="objdump"
STRINGS="strings"
READELF="readelf"

ENABLE_MOLD="false"
ENABLE_ICF="false"
EXTRA_CXXFLAGS="${EXTRA_CXXFLAGS} -stdlib=libc++"
