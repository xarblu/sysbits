From d3eb8f4e0859ff0448eacf33b7df121579b7b25e Mon Sep 17 00:00:00 2001
From: Adel KARA SLIMANE <adel.ks@zegrapher.com>
Date: Sun, 27 Sep 2026 16:40:15 +0200
Subject: [PATCH] libvmaf/svm.cpp: use std:: min,max,swap instead of custom
 defined ones

Avoids ambiguity that is reported by clang.

Closes: #1616
---
 libvmaf/src/svm.cpp | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/libvmaf/src/svm.cpp b/libvmaf/src/svm.cpp
index 94d3379d80..6cb06640b3 100644
--- a/libvmaf/src/svm.cpp
+++ b/libvmaf/src/svm.cpp
@@ -11,17 +11,17 @@
 #include <fstream>
 #include <sstream>
 #include <vector>
+#include <utility>
+#include <algorithm>
 #include "svm.h"
 int libsvm_version = LIBSVM_VERSION;
 typedef float Qfloat;
 typedef signed char schar;
-#ifndef min
-template <class T> static inline T min(T x,T y) { return (x<y)?x:y; }
-#endif
-#ifndef max
-template <class T> static inline T max(T x,T y) { return (x>y)?x:y; }
-#endif
-template <class T> static inline void swap(T& x, T& y) { T t=x; x=y; y=t; }
+
+using std::min;
+using std::max;
+using std::swap;
+
 template <class S, class T> static inline void clone(T*& dst, S* src, int n)
 {
 	dst = new T[n];
