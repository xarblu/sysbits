From c74f9be21e5f4ac9c27056682086dc21b5346066 Mon Sep 17 00:00:00 2001
From: Xarblu <xarblu@protonmail.com>
Date: Fri, 7 Aug 2026 16:21:57 +0200
Subject: [PATCH] Makefiles: pass -mfpmath=387 with -mgeneral-regs-only

Signed-off-by: Xarblu <xarblu@protonmail.com>
---
 sysdeps/x86/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/sysdeps/x86/Makefile b/sysdeps/x86/Makefile
index e32a430bb9..598fbdaee3 100644
--- a/sysdeps/x86/Makefile
+++ b/sysdeps/x86/Makefile
@@ -153,7 +153,7 @@ endif
 endif
 
 ifeq ($(subdir),gmon)
-CFLAGS-mcount.c += -mgeneral-regs-only
+CFLAGS-mcount.c += -mgeneral-regs-only -mfpmath=387
 endif
 
 ifeq ($(subdir),math)
