[Unit]
Description=Tube Archivist Server
After=tubearchivist-redis.service tubearchivist-elasticsearch.service tubearchivist-pot-provider.service
Requires=tubearchivist-redis.service tubearchivist-elasticsearch.service
Wants=tubearchivist-pot-provider.service
RequiresMountsFor=/var/lib/tubearchivist

[Container]
# go unstable if yt-dlp can't beat new yt challenges
Image=docker.io/bbilly1/tubearchivist:v0.6.0
AutoUpdate=registry

Label='wud.tag.include=^v\\d+\\.\\d+\\.\\d+$$'
Label='wud.tag.transform=^v(\\d+\\.\\d+\\.\\d+)$$ => $$1'
Label='wud.link.template=https://github.com/tubearchivist/tubearchivist/releases/tag/v$${major}.$${minor}.$${patch}'
Label='wud.watch=true'

Label='glance.name=Tube Archivist'
Label='glance.icon=/assets/services/tube-archivist.png'
Label='glance.url=https://tubearchivist.sillylizard.dev/'
Label='glance.description=YouTube media server'
Label='glance.hide=false'
Label='glance.id=tubearchivist'

Pod=tubearchivist.pod

# recommended non-root UID/GID
# must be owner of /cache and /youtube volumes
User=1000:1000

EnvironmentFile=/var/lib/tubearchivist/tubearchivist-app.env

Volume=/var/lib/tubearchivist/app-media:/youtube:idmap
Volume=/var/lib/tubearchivist/app-cache:/cache:idmap
Volume=/etc/localtime:/etc/localtime:ro

# TA has a fairly strict trusted hosts list (afaik only "${TA_HOST}" and "localhost")
# so we'll explicitly say we're localhost
HealthCmd=curl --fail-with-body --silent --show-error --header "Host: localhost" http://127.0.0.1:8000/api/health/
Notify=healthy

[Service]
TimeoutStartSec=10min
Restart=on-failure

[Install]
WantedBy=multi-user.target
