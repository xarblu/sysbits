[Unit]
Description=Scrutiny InfluxDB
RequiresMountsFor=/var/lib/scrutiny

[Container]
Image=docker.io/influxdb:2.9.1-alpine
AutoUpdate=registry
Label='wud.tag.include=^2\\.\\d+\\.\\d+-alpine$$'
Label='wud.watch=true'

Label='glance.name=Database'
Label='glance.hide=false'
Label='glance.parent=scrutiny'

Pod=scrutiny.pod

# influxdb user
User=1000

Volume=/var/lib/scrutiny/influxdb:/var/lib/influxdb2:idmap

HealthCmd=curl --fail-with-body --silent --show-error http://127.0.0.1:8086/health
Notify=healthy

[Service]
TimeoutStartSec=10min
Restart=on-failure

[Install]
WantedBy=multi-user.target
