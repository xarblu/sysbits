[Unit]
Description=Tube Archivist BgUtils POT Provider

[Container]
# should match the tubearchivist plugin's __version__ here:
# https://github.com/bbilly1/bgutil-ytdlp-pot-provider/blob/feat/add-disable-flag/plugin/yt_dlp_plugins/extractor/getpot_bgutil.py
Image=docker.io/brainicism/bgutil-ytdlp-pot-provider:2.0.2
Pull=newer

Label='wud.tag.include=^\\d+\\.\\d+\\.\\d+$$'
Label='wud.watch=true'

Label='glance.name=BgUtils POT Provider'
Label='glance.hide=false'
Label='glance.parent=tubearchivist'

Pod=tubearchivist.pod

# README.md says to run with --init
RunInit=true

#HealthCmd=

[Service]
TimeoutStartSec=10min
Restart=on-failure

[Install]
WantedBy=multi-user.target
