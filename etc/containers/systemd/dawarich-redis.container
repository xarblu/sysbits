[Unit]
Description=Dawarich Redis
RequiresMountsFor=/var/lib/dawarich

[Container]
Image=docker.io/valkey/valkey:8.1.10-alpine3.24
AutoUpdate=registry

Label='wud.tag.include=^8\\.\\d+\\.\\d+-alpine\\d+.\\d+$$'
Label='wud.tag.transform=^(\\d+\\.\\d+\\.\\d+)(-alpine)(\\d+.\\d+)$$ => $$1$$2.$$3'
Label='wud.link.template=https://github.com/valkey-io/valkey/releases/tag/$${major}.$${minor}.$${patch}'
Label='wud.watch=true'

Label='glance.name=Valkey'
Label='glance.hide=false'
Label='glance.parent=dawarich'

Pod=dawarich.pod

EnvironmentFile=/var/lib/dawarich/dawarich-postgres.env

Volume=/var/lib/dawarich/shared:/data:idmap

Exec=redis-server --save 900 1 --save 300 10 --appendonly no

HealthCmd=redis-cli --raw incr ping
Notify=healthy

[Service]
TimeoutStartSec=10min
Restart=on-failure

[Install]
WantedBy=multi-user.target
